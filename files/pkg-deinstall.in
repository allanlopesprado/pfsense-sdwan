#!/bin/sh
[ -z "${PKG_ROOTDIR#/}" ] || exit 0
[ "${PKG_CHROOTED:-}" != true ] || exit 0
# The new post-install hook restarts the observer and refreshes registration.
[ -z "${PKG_UPGRADE:-}" ] || exit 0
removal_ready=/var/run/sdwan-package-removal.ready

register_removal() {
	if [ -f /var/run/php-fpm.pid ]; then
		/usr/local/bin/php -f /etc/rc.packages %%PORTNAME%% "$1"
	else
		# rc.packages defers when PHP-FPM is down, but its removal API is CLI-safe.
		# shellcheck disable=SC2016
		/usr/local/bin/php -r '
			require_once("config.inc");
			require_once("functions.inc");
			require_once("filter.inc");
			require_once("shaper.inc");
			require_once("captiveportal.inc");
			require_once("pkg-utils.inc");
			require_once("pfsense-utils.inc");
			$pkg_interface = "console";
			$package = $argv[1];
			pkg_remove_prefix($package);
			delete_package_xml($package, strtolower($argv[2]));
		' -- %%PORTNAME%% "$1"
	fi
}

case "${2:-}" in
DEINSTALL)
	rm -f "$removal_ready" || exit 1
	# Avoid a second invalidation when native package cleanup stops the service.
	export SDWAN_PACKAGE_REMOVING=1
	if [ -x /usr/local/etc/rc.d/sdwand.sh ]; then
		if ! /usr/local/etc/rc.d/sdwand.sh stop >/dev/null 2>&1 &&
		    /usr/local/etc/rc.d/sdwand.sh status >/dev/null 2>&1; then
			echo 'SD-WAN observer is still running. Stop it and retry removal.' >&2
			exit 1
		fi
		if [ -f /var/run/sdwan-expiry.pid ] &&
		    /usr/local/etc/rc.d/sdwand.sh watchdog_status >/dev/null 2>&1; then
			echo 'SD-WAN expiry guard is still running. Stop it and retry removal.' >&2
			exit 1
		fi
	elif [ -f /var/run/sdwand.pid ] || [ -f /var/run/sdwan-expiry.pid ]; then
		echo 'SD-WAN observer status cannot be checked. Restore the service script before removal.' >&2
		exit 1
	fi
	if [ -f /usr/local/pkg/sdwan_invalidate.inc ]; then
		/usr/local/bin/php -f /usr/local/pkg/sdwan_invalidate.inc || exit 1
	elif [ -f /var/run/sdwan-observer.json.forwarded ] || [ -f /var/run/sdwan-filter-commit.json ]; then
		echo 'SD-WAN forwarding withdrawal cannot be checked. Restore the package helper before removal.' >&2
		exit 1
	fi
	register_removal "$2" || exit 1
	# /var/run is root-owned. Publish only after all pre-removal checks passed.
	(umask 077; set -C; : > "$removal_ready")
	;;
POST-DEINSTALL)
	# pkg can continue to the post hook even when the pre hook failed.
	[ -f "$removal_ready" ] || exit 0
	rm -f "$removal_ready" || exit 1
	register_removal "$2" || exit 1
	# The observer is stopped, PF withdrawal was checked, and the package is gone.
rm -f /var/run/sdwand.pid /var/run/sdwan-expiry.pid /var/run/sdwan-expiry.heartbeat /var/run/sdwan-filter-commit.json \
		/var/run/sdwan-observer.json /var/run/sdwan-observer.json.forwarded \
		/var/run/sdwan-observer.json.events /var/run/sdwan-observer.json.lock || exit 1
	for lock in /var/run/sdwan-settings.lock /var/run/sdwan-package-upgrade.lock; do
		/usr/bin/lockf -kns -t 0 "$lock" /bin/rm -f "$lock" || :
	done
	;;
*) exit 0 ;;
esac
